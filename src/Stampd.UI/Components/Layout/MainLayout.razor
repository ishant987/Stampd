@inherits LayoutComponentBase
@inject IHostEnvironment HostEnv
@inject CurrentUserService CurrentUser

<div class="stampd-app">
    <header class="stampd-topbar">
        <div class="stampd-topbar-inner">
            <a href="/" class="stampd-brand" style="text-decoration:none; color:inherit;">
                <span class="stampd-brand-mark">S</span>
                <span class="stampd-brand-title">Stampd</span>
                <span class="stampd-brand-sub">Digital Signatures</span>
            </a>

            <nav class="stampd-topbar-nav">
                <a href="/">Home</a>
                <a href="/demo">Demo</a>
                <a href="/designer">Designer</a>
                <a href="/designer/requests">Requests</a>
                @if (CurrentUser.IsInRole(Core.Authorization.StampdRoles.Admin))
                {
                    <a href="/admin" title="Admin dashboard">Admin</a>
                }
            </nav>

            <div class="stampd-nav-spacer"></div>

            <div class="stampd-topbar-actions">
                @* v2.0 — user chip on the right. In Dev shows the auto-mint subject +
                   role badges; in non-Dev degrades to "Not signed in" until cookie
                   auth lands. *@
                @if (CurrentUser.IsAuthenticated)
                {
                    <div class="stampd-user-chip" title="Signed in as @CurrentUser.DisplayName">
                        <span class="stampd-user-name">@CurrentUser.DisplayName</span>
                        @foreach (var role in CurrentUser.Roles)
                        {
                            <span class="stampd-chip stampd-chip--accent" style="font-size:0.66rem; letter-spacing:0.05em;">@role</span>
                        }
                    </div>
                }

                @* Pure-JS toggle so it works on Static SSR pages without an interactive
                   render mode. Icon swaps in theme.js as the document attribute changes. *@
                <button class="stampd-theme-toggle"
                        type="button"
                        data-theme-toggle
                        aria-label="Toggle theme"
                        title="Toggle theme"
                        onclick="window.stampdTheme.toggle()">
                    ☾
                </button>
            </div>
        </div>
    </header>

    <main class="stampd-main">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="stampd-card">
                    <h2 class="stampd-page-title">Something went wrong</h2>
                    <p class="stampd-page-subtitle">@ex.Message</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <footer class="stampd-footer">
        <span>&copy; @DateTime.Now.Year Stampd — open-source e-signature for .NET. Apache 2.0.</span>
        <span>Build @System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version</span>
    </footer>
</div>

<FluentToastProvider />
<FluentDialogProvider />


