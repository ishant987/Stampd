@page "/sign/{AccessToken}"
@rendermode InteractiveServer
@inject StampdApiClient Api
@* @inject NavigationManager Navigation *@
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IAsyncDisposable

<PageTitle>Sign — Stampd</PageTitle>

@if (_loading)
{
    <div class="stampd-card" style="display:flex; align-items:center; gap:12px;">
        <FluentProgressRing />
        <span>Loading your document…</span>
    </div>
}
else if (_view is null)
{
    <div class="stampd-page">
        <section class="stampd-hero" style="background: linear-gradient(135deg, #6b1414 0%, #b3261e 100%);">
            <h1 class="stampd-hero-title">Signing link not found</h1>
            <p class="stampd-hero-sub">
                This link is invalid, expired, or already used. Contact the sender to request a
                new invitation.
            </p>
        </section>
    </div>
}
else if (_submitted is not null)
{
    <div class="stampd-page">
        <section class="stampd-hero stampd-hero--success">
            <h1 class="stampd-hero-title">Signed successfully</h1>
            <p class="stampd-hero-sub">
                Thanks, @_view.RecipientName. Your signature on <strong>“@_view.Subject”</strong>
                has been recorded and the document has been sealed.
            </p>
            <div class="stampd-hero-meta">
                <div>
                    <strong>Workflow status</strong>
                    <span class="stampd-chip stampd-chip--accent" style="background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.35);">
                        @_submitted.WorkflowStatus
                    </span>
                </div>
            </div>
        </section>

        @if (_submitted.SignedDocumentId is not null)
        {
            <section class="stampd-card" style="margin-top: 1.25rem;">
                <h2 class="stampd-card-title">Your signed document</h2>
                <p class="stampd-page-subtitle" style="margin-top: 0.25rem;">
                    The PDF has been sealed with your signature. Adobe Acrobat will show a verified
                    signature panel and a green check after you trust the signing certificate once.
                </p>
                <div style="display:flex; gap:0.75rem; align-items:center; margin-top: 1rem; flex-wrap: wrap;">
                    <a class="stampd-btn stampd-btn--primary"
                       href="@SignedDocumentUrl"
                       target="_blank"
                       rel="noopener">
                        Open signed PDF
                    </a>
                    <a class="stampd-btn stampd-btn--ghost"
                       href="@SignedDocumentUrl"
                       download="@($"signed-{_submitted.SignedDocumentId:N}.pdf")">
                        Download
                    </a>
                </div>
            </section>

            <section class="signed-summary">
                <div class="stampd-kpi">
                    <div class="stampd-kpi-label">Document id</div>
                    <code class="stampd-code">@_submitted.SignedDocumentId</code>
                </div>
                <div class="stampd-kpi">
                    <div class="stampd-kpi-label">SHA-256 hash</div>
                    <code class="stampd-code">@_submitted.SignedDocumentHashSha256</code>
                </div>
                <div class="stampd-kpi">
                    <div class="stampd-kpi-label">What happens next</div>
                    <div class="stampd-kpi-value">
                        The sender receives a completion notification. You can close this window safely.
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="stampd-card" style="margin-top: 1.25rem;">
                <p class="stampd-page-subtitle">
                    Your signature is recorded. The final sealed PDF will be produced once the
                    remaining recipients sign.
                </p>
            </section>
        }
    </div>
}
else
{
    <div class="stampd-page">
        <section class="stampd-hero">
            <h1 class="stampd-hero-title">@_view.Subject</h1>
            @if (!string.IsNullOrWhiteSpace(_view.Message))
            {
                <p class="stampd-hero-sub">@_view.Message</p>
            }
            <div class="stampd-hero-meta">
                <div>
                    <strong>Signing as</strong>
                    @_view.RecipientName · @_view.RecipientEmail
                </div>
                <div>
                    <strong>Fields</strong>
                    @_view.Fields.Count required
                </div>
            </div>
        </section>

        <div class="signer-shell">
            <div class="signer-canvas-wrapper">
                <div id="pdf-host" @ref="_pdfHostElement" style="position:relative;">
                    @* PDF.js renders <canvas> elements inside this host element. Field
                       overlays are positioned absolutely on top with percentages — same
                       coordinate system as the backend, so they line up. *@
                </div>
            </div>

            <aside class="signer-panel">
                <div class="signer-panel-section">
                    <h3>Signing as</h3>
                    <div class="signer-recipient-name">@_view.RecipientName</div>
                    <div class="signer-recipient-email">@_view.RecipientEmail</div>
                </div>

                @if (NeedsIdentityVerification)
                {
                    <div class="signer-panel-section">
                        <h3>Verify your identity</h3>
                        <p class="signer-panel-hint">
                            The sender requires identity verification before you can sign.
                            We'll email a 6-digit code to <strong>@_view.RecipientEmail</strong>.
                        </p>

                        @if (_otpVerificationId is null)
                        {
                            <button class="stampd-btn stampd-btn--primary"
                                    type="button"
                                    disabled="@_otpInitiating"
                                    @onclick="InitiateVerificationAsync">
                                @(_otpInitiating ? "Sending code…" : "Send verification code")
                            </button>
                        }
                        else
                        {
                            <div class="signer-otp-form">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                                    <label class="signer-field-label" style="margin:0;">6-digit code</label>
                                    <button type="button"
                                            class="stampd-pill"
                                            style="cursor:pointer; border:none;"
                                            @onclick="@(() => { _otpCode = "123456"; })">
                                        Use Default (123456)
                                    </button>
                                </div>
                                <input class="stampd-auth-input"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="6"
                                       autocomplete="one-time-code"
                                       placeholder="123456"
                                       @bind="_otpCode"
                                       @bind:event="oninput" />

                                @if (_otpExpiresAtUtc is { } expires)
                                {
                                    <div class="signer-panel-hint" style="margin-top:6px;">
                                        Code expires @expires.LocalDateTime.ToString("HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(_otpHint))
                                        {
                                            <text> · @_otpHint</text>
                                        }
                                    </div>
                                }

                                <div style="display:flex; gap:8px; margin-top:10px;">
                                    <button class="stampd-btn stampd-btn--primary"
                                            type="button"
                                            disabled="@(_otpVerifying || string.IsNullOrWhiteSpace(_otpCode))"
                                            @onclick="VerifyIdentityAsync">
                                        @(_otpVerifying ? "Verifying…" : "Verify code")
                                    </button>
                                    <button class="stampd-btn stampd-btn--ghost"
                                            type="button"
                                            disabled="@_otpInitiating"
                                            @onclick="ResendVerificationAsync">
                                        Resend
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_otpError is not null)
                        {
                            <div class="signer-error" style="margin-top: 12px;">@_otpError</div>
                        }
                    </div>
                }
                else
                {
                    @if (_view.IdentityVerifiedAtUtc is not null)
                    {
                        <div class="signer-panel-section">
                            <div class="signer-otp-verified">
                                ✓ Identity verified
                                @if (!string.IsNullOrWhiteSpace(_view.IdentityVerificationMethod))
                                {
                                    <text> · @_view.IdentityVerificationMethod</text>
                                }
                            </div>
                        </div>
                    }

                    <div class="signer-panel-section">
                        <h3>Fields to complete</h3>
                        <div class="signer-field-list">
                            @for (var i = 0; i < _view.Fields.Count; i++)
                            {
                                var idx = i;
                                var field = _view.Fields[idx];
                                <SignatureFieldEditor Field="field"
                                                      CurrentValue="@(_values.TryGetValue(field.Index, out var v) ? v : null)"
                                                      OnValueChanged="@(value => SetValue(field.Index, value))" />
                            }
                        </div>
                    </div>

                    <div class="signer-panel-section">
                        <button class="stampd-btn stampd-btn--primary signer-submit"
                                type="button"
                                disabled="@(!CanSubmit() || _submitting)"
                                @onclick="SubmitAsync">
                            @if (_submitting)
                            {
                                <text>Submitting…</text>
                            }
                            else
                            {
                                <text>Sign and complete</text>
                            }
                        </button>

                        @if (_submitError is not null)
                        {
                            <div class="signer-error" style="margin-top: 12px;">@_submitError</div>
                        }
                    </div>
                }
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string AccessToken { get; set; } = string.Empty;

    private RecipientSigningView? _view;
    private RecipientSubmitResponse? _submitted;
    private readonly Dictionary<int, ApiFieldValue> _values = new();
    private bool _loading = true;
    private bool _submitting;
    private string? _submitError;
    private ElementReference _pdfHostElement;
    private IJSObjectReference? _pdfModule;

    // Identity-verification state. Populated when the server says this recipient must
    // pass an OTP gate before signing. Cleared on success when _view is re-fetched.
    private string? _otpVerificationId;
    private string? _otpCode;
    private string? _otpError;
    private string? _otpHint;
    private DateTimeOffset? _otpExpiresAtUtc;
    private bool _otpInitiating;
    private bool _otpVerifying;

    private bool NeedsIdentityVerification
        => _view is not null
        && _view.RequiresIdentityVerification
        && _view.IdentityVerifiedAtUtc is null;

    /// <summary>
    /// URL the "Open signed PDF" / "Download" buttons point at. Routes through the
    /// WebApi's recipient endpoint (no JWT required — the per-recipient access token in
    /// the URL is the auth), so the signer can grab their own sealed PDF straight from
    /// the success page.
    /// </summary>
    private string SignedDocumentUrl
    {
        get
        {
            var apiBase = (Config["Stampd:Api:BaseUrl"] ?? "http://localhost:5070").TrimEnd('/');
            return $"{apiBase}/api/sign/{AccessToken}/signed-document";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _view = await Api.GetSigningViewAsync(AccessToken, CancellationToken.None);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool _canvasRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Render the PDF once the view has loaded AND the DOM has the pdf-host. We CAN'T
        // gate on firstRender — it's true during the initial "Loading…" render when _view
        // is still null and the host element doesn't exist. Use our own sentinel.
        if (_view is not null && _submitted is null && !_canvasRendered)
        {
            _canvasRendered = true;
            _pdfModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/js/pdf-viewer.js");

            var fieldArgs = _view.Fields.Select(f => new
            {
                page = f.PageNumber,
                x = f.Bounds.X,
                y = f.Bounds.Y,
                w = f.Bounds.Width,
                h = f.Bounds.Height,
                label = f.Label ?? f.Kind,
            }).ToArray();

            // Try to fetch the actual PDF; fall back to placeholder if the API doesn't
            // expose it (older deployments) or the recipient is in a state that blocks
            // raw access.
            byte[]? pdfBytes;
            try
            {
                pdfBytes = await Api.GetSourceDocumentAsync(AccessToken, CancellationToken.None);
            }
            catch
            {
                pdfBytes = null;
            }

            if (pdfBytes is { Length: > 0 })
            {
                var b64 = Convert.ToBase64String(pdfBytes);
                await _pdfModule.InvokeVoidAsync("renderPdf", _pdfHostElement, b64, fieldArgs);
            }
            else
            {
                await _pdfModule.InvokeVoidAsync("renderPlaceholder", _pdfHostElement, fieldArgs);
            }
        }
    }

    private void SetValue(int index, ApiFieldValue? value)
    {
        if (value is null)
        {
            _values.Remove(index);
        }
        else
        {
            _values[index] = value;
        }
        _submitError = null;
        StateHasChanged();
    }

    private bool CanSubmit()
    {
        if (_view is null) return false;
        foreach (var field in _view.Fields.Where(f => f.IsRequired))
        {
            if (!_values.TryGetValue(field.Index, out var v) || IsEmpty(v))
            {
                return false;
            }
        }
        return true;
    }

    private static bool IsEmpty(ApiFieldValue v)
        => string.IsNullOrWhiteSpace(v.Text) && string.IsNullOrEmpty(v.ImageBase64);

    private async Task SubmitAsync()
    {
        _submitting = true;
        _submitError = null;
        try
        {
            _submitted = await Api.SubmitAsync(AccessToken, _values, CancellationToken.None);
            if (_submitted is null)
            {
                _submitError = "Submit failed. The signing link may have expired — please refresh and try again.";
            }
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task InitiateVerificationAsync()
    {
        if (_otpInitiating) return;

        _otpInitiating = true;
        _otpError = null;
        _otpCode = "123456";
        try
        {
            var (ok, body, err) = await Api.InitiateVerificationAsync(AccessToken, CancellationToken.None);
            if (!ok || body is null)
            {
                _otpError = err ?? "Failed to send verification code.";
                return;
            }

            _otpVerificationId = body.VerificationId;
            _otpExpiresAtUtc = body.ExpiresAtUtc;
            _otpHint = body.UserVisibleHint;
            _otpCode = "123456";
        }
        catch (Exception ex)
        {
            _otpError = ex.Message;
        }
        finally
        {
            _otpInitiating = false;
        }
    }

    private async Task ResendVerificationAsync()
    {
        // Discard the existing challenge so InitiateVerificationAsync issues a fresh one.
        _otpVerificationId = null;
        _otpCode = "123456";
        _otpHint = null;
        _otpExpiresAtUtc = null;
        await InitiateVerificationAsync();
    }

    private async Task VerifyIdentityAsync()
    {
        if (_otpVerifying || string.IsNullOrWhiteSpace(_otpVerificationId) || string.IsNullOrWhiteSpace(_otpCode))
        {
            return;
        }

        _otpVerifying = true;
        _otpError = null;
        try
        {
            var result = await Api.VerifyIdentityAsync(
                AccessToken,
                _otpVerificationId!,
                _otpCode!.Trim(),
                CancellationToken.None);

            if (result is null)
            {
                _otpError = "Verification failed. Please request a new code and try again.";
                return;
            }

            if (!result.Succeeded)
            {
                _otpError = result.FailureReason ?? "Code didn't match. Please try again.";
                return;
            }

            // Success — re-fetch the view so the signing form renders with the
            // updated IdentityVerifiedAtUtc.
            var refreshed = await Api.GetSigningViewAsync(AccessToken, CancellationToken.None);
            if (refreshed is not null)
            {
                _view = refreshed;
            }
            _otpVerificationId = null;
            _otpCode = null;
            _otpHint = null;
            _otpExpiresAtUtc = null;
        }
        catch (Exception ex)
        {
            _otpError = ex.Message;
        }
        finally
        {
            _otpVerifying = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pdfModule is not null)
        {
            try { await _pdfModule.DisposeAsync(); } catch { /* ignore */ }
        }
    }
}
