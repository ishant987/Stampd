<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Stampd.WebApi</RootNamespace>
    <UserSecretsId>stampd-webapi-dev</UserSecretsId>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA1848 / CA1873 — high-performance logging rules that demand LoggerMessage.Define
      delegates. The WebApi's logging hot paths are infrequent enough (dispatch, audit
      events, exception paths) that the message-construction cost is negligible. Adopting
      LoggerMessage.Define everywhere would be a large mechanical change for no measurable
      benefit; suppress project-wide and revisit if profiling ever shows logging on the
      hot path.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stampd.Core\Stampd.Core.csproj" />
    <ProjectReference Include="..\Stampd.Engine\Stampd.Engine.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.LocalCertificate\Stampd.Crypto.LocalCertificate.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.Vault\Stampd.Crypto.Vault.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.AzureKeyVault\Stampd.Crypto.AzureKeyVault.csproj" />
    <ProjectReference Include="..\Stampd.Crypto.AwsKms\Stampd.Crypto.AwsKms.csproj" />
    <ProjectReference Include="..\Stampd.Timestamp.Rfc3161\Stampd.Timestamp.Rfc3161.csproj" />
    <ProjectReference Include="..\Stampd.Timestamp.FreeTsa\Stampd.Timestamp.FreeTsa.csproj" />
    <ProjectReference Include="..\Stampd.Infrastructure\Stampd.Infrastructure.csproj" />
    <ProjectReference Include="..\Stampd.Infrastructure.Sqlite\Stampd.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\Stampd.Infrastructure.MySql\Stampd.Infrastructure.MySql.csproj" />
    <ProjectReference Include="..\Stampd.Storage.FileSystem\Stampd.Storage.FileSystem.csproj" />
    <ProjectReference Include="..\Stampd.Storage.S3\Stampd.Storage.S3.csproj" />
    <ProjectReference Include="..\Stampd.Storage.AzureBlob\Stampd.Storage.AzureBlob.csproj" />
    <ProjectReference Include="..\Stampd.Storage.Gcs\Stampd.Storage.Gcs.csproj" />
    <ProjectReference Include="..\Stampd.Revocation.Http\Stampd.Revocation.Http.csproj" />
    <ProjectReference Include="..\Stampd.Email.Smtp\Stampd.Email.Smtp.csproj" />
    <ProjectReference Include="..\Stampd.Identity.EmailOtp\Stampd.Identity.EmailOtp.csproj" />
    <ProjectReference Include="..\Stampd.Identity.Oidc\Stampd.Identity.Oidc.csproj" />
    <ProjectReference Include="..\Stampd.Identity.Saml2\Stampd.Identity.Saml2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.OpenApi ships the native OpenAPI generator (the replacement for
      Swashbuckle) in .NET 9+. Pair with Scalar.AspNetCore for a polished docs UI.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />

    <!-- Structured logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Health checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />

    <!--
      EF Core design-time tooling. Required ONLY by `dotnet ef` (migrations add /
      database update / script). PrivateAssets="all" + IncludeAssets="..." keeps it
      out of the published WebApi binary — it lives only in the dev-time tool graph.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- JWT auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />

    <!-- OpenTelemetry: distributed traces + metrics.
         1.10.0 has CVE advisories (GHSA-8785-wc3w-h8q6, GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9);
         1.13.x is the patched line. EntityFrameworkCore instrumentation tracks the core trace
         release within a minor of the OTel API. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.13.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  </ItemGroup>

</Project>
