<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 — missing XML doc comments on public members (we suppress because Generate-
               DocumentationFile is on for package metadata, not strict doc enforcement).
      CA1720 — identifier contains type name. Stampd's domain vocabulary (Signed, Sealed,
               Object) overlaps reserved words; renaming would distort the model.
      CA1861 — constant array argument. EF Core scaffolds migrations that pass column-name
               arrays inline at table-creation time; the analyser flags the pattern but it
               runs once per migration, not in a hot loop, and EF will regenerate the same
               shape every time. Not actionable.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1720;CA1861;NU1901;NU1902;NU1903;NU1904;NU1905</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <NuGetAudit>false</NuGetAudit>

    <!--
      Enforce NuGet lock files solution-wide. Generates packages.lock.json next
      to every csproj on restore and makes the build fail if any transitive
      version drifts from what's locked. Required by OSSF Scorecard's
      PinnedDependenciesID rule (nugetCommand not pinned by hash) and by
      Qodana Ultimate's SCA pipeline (reads packages.lock.json for CVE scan).
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!--
      Single source of truth for package version. Bump here on every release; CI publishes
      whatever's checked in when the tag pushes. Pre-releases use a suffix — set Version
      to the target stable (e.g. 1.3.0) and add VersionSuffix (e.g. preview.1) so the
      effective package version becomes 1.3.0-preview.1.
    -->
    <!--
      v3.0.0 stable. v3.0 train shipped four pieces: tenant-isolated admin scopes
      (alpha.1), OIDC relay for external IdPs (alpha.2), SAML2 SP scaffolding
      (alpha.3), and industry compliance bundles (this release). Rules engine
      moved to v3.1 candidates.
    -->
    <Version>3.0.0</Version>

    <Product>Stampd</Product>
    <Authors>Suresh Subramanian and Stampd contributors</Authors>
    <Company>Stampd</Company>
    <Copyright>Copyright (c) Stampd contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/isureshsubramanian/Stampd</PackageProjectUrl>
    <RepositoryUrl>https://github.com/isureshsubramanian/Stampd</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!--
      Per-project files. Each library csproj sets PackageReadmeFile to its local README.md
      (placed next to the csproj). Apps (Stampd.WebApi, Stampd.UI), samples, and tests
      override IsPackable=false so they're excluded from the pack pass below.
    -->
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Embed XML docs + symbols inside the package so consumers can step into Stampd code
      from their IDE without a separate .snupkg. snupkg is the better long-term path
      (smaller .nupkg, symbols on Microsoft's symbol server), but embedding is friction-free
      for the 1.2 release.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup Label="SourceLink" Condition="'$(IsPackable)' == 'true'">
    <!--
      Source Link maps PDB line numbers back to the corresponding github.com blob URL, so
      anyone consuming a Stampd package can step into source-tagged at the released SHA
      without needing the .snupkg or a local clone.
    -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup Label="Deterministic builds">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
